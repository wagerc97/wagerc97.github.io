// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "gutter": {
    "line_numbers": true
  },
  "relative_line_numbers": "disabled",
  "languages": {
    "Python": {
      "show_edit_predictions": true,
    "language_servers": [
      // Enable ty, disable basedpyright, and enable all
      // other registered language servers (ruff, pylsp, pyright).
      "ty",
      //"pyright",
      "ruff",
      "!basedpyright",
    ]
    }

  },
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot"
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "terminal_init_command": "codex",
    "commit_message_model": {
      "provider": "gemini",
      "model": "3.5 Flash"
    },
    "commit_message_instructions": "Write a highly detailed commit message. Include a short imperative summary line (max 50 characters), followed by a blank line, and then a bulleted body explaining the technical justification, why the changes were made, and any breaking consequences. Use the Conventional Commits format: <type>(<scope>): <summary>\n<detailed bulletpoints>."
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "tabs": {
    "git_status": false,
  },
  "project_panel": {
    "dock": "left",
  },
  "agent_buffer_font_size": 15.0,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "ui_font_weight": 400.0,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "terminal": {
    "font_size": 12.0,
    "font_family": "JetBrains Mono",
  },
  "mouse_wheel_zoom": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 0,
    },
  },
  "buffer_font_fallbacks": ["monospace"],
  "buffer_font_family": "JetBrains Mono",
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 20.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dark Stealth",
  },
  // searching after timeout with debounced value. Source: https://github.com/zed-industries/zed/issues/7087
  "hidden_files": [],
  "search": {
  "button": true,
  "include_ignored": false,  // can override the search exclusions! keep FALSE
  },
  "file_scan_exclusions": [
    "**/.venv",
    "**/build",
    "**/dist",
    "**/__pycache__",
    "**/*.egg-info",
    "**/*cache*",
    "**/.vscode",
    "**/.obsidian",
    "**/.pandoc",
    "**/.pixi",
    "**/.git",
    "**/.pytest_cache",
    "**/node_modules",
    "**/*.zip",
    "**/*.js",
    "**/*.whl",
    "**/*.log",
    "**/*.log.*",
    "**/out_*",
    //"**/*.html",
  ],
  "file_scan_inclusions": [
    //"**/*"
  ],
  // render e.g. arrows
  "buffer_font_features": {
    "calt": false // false = Disable ligatures
  }
}
